<Window x:Class="GitCount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GitCount - 多项目 Git 统计"
        Width="1380" Height="940"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="RightColumnHeader"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="SidebarModeButton" TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8FA0BA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#0D1729" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,24,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#2563EB">
                        <Grid>
                            <TextBlock Text="G"
                                       FontFamily="Segoe UI"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-4,0,0" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,7">
                                <Border Width="3" Height="5" Background="#BFDBFE" Margin="0,0,2,0" />
                                <Border Width="3" Height="8" Background="#BFDBFE" Margin="0,0,2,0" />
                                <Border Width="3" Height="11" Background="#BFDBFE" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GitCount" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="多项目提交统计" FontSize="11" Foreground="#8290A8" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#0F192A"
                        BorderBrush="#1E2C43"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="3"
                        Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="本地模式"
                                Click="ModeLocal_Click"
                                IsEnabled="{Binding IsNotBusy}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocalMode}" Value="True">
                                            <Setter Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1"
                                Content="线上模式"
                                Click="ModeGitLab_Click"
                                IsEnabled="{Binding IsNotBusy}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGitLabMode}" Value="True">
                                            <Setter Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Row="2"
                        Style="{StaticResource PrimaryButton}"
                        Height="36"
                        Margin="0,12,0,0"
                        Click="AddProject_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        Visibility="{Binding IsLocalMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Margin="0,-2,7,0" />
                        <TextBlock Text="添加项目" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2"
                        Style="{StaticResource PrimaryButton}"
                        Height="36"
                        Margin="0,12,0,0"
                        Content="GitLab 项目管理"
                        Click="ManageGitLabProjects_Click"
                        IsEnabled="{Binding IsNotBusy}"
                        Visibility="{Binding IsGitLabMode, Converter={StaticResource BoolToVisibility}}" />

                <Grid Grid.Row="3" Margin="0,20,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProjectListTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E4E7EC" />
                        <Border Background="#18243A" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ProjectCountText}" FontSize="10" Foreground="#AFC0DB" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="全选" Style="{StaticResource TextButton}" Click="SelectAll_Click" Foreground="#7DAEFF" />
                        <Button Content="全不选" Style="{StaticResource TextButton}" Click="SelectNone_Click" Foreground="#7DAEFF" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121D30"
                                            BorderBrush="#1E2C43"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Row="0" Grid.Column="0"
                                                      IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Foreground="#F2F4F7"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Margin="10,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Content="×"
                                                    Style="{StaticResource SidebarRemoveButton}"
                                                    Tag="{Binding}"
                                                    Click="RemoveProject_Click"
                                                    ToolTip="移除项目"
                                                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding Path}"
                                                       Foreground="#7D8AA1"
                                                       FontSize="10.5"
                                                       Margin="10,4,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="!"
                                                       Foreground="#F79009"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding ErrorToolTip}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="#0F192A"
                            BorderBrush="#1E2C43"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,28"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#18243A" HorizontalAlignment="Center">
                                <TextBlock Text="+"
                                           FontSize="23"
                                           Foreground="#6E8BB8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0" />
                            </Border>
                            <TextBlock Text="还没有项目"
                                       Foreground="#D0D5DD"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="{Binding EmptyProjectListHint}"
                                       Foreground="#7D8AA1"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <Border Height="1" Background="#1E2C43" Margin="0,0,0,14" />
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding GitStatusTone, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding GitStatusText}"
                                       Foreground="#98A2B3"
                                       FontSize="11"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding GitStatusTooltip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModeFooterText}"
                                   Foreground="#56657D"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding ModeStorageText}"
                               Foreground="#56657D"
                               FontSize="10"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="提交统计"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HeaderDescription}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#EAF2FF"
                        CornerRadius="10"
                        Padding="11,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ModeBadgeText}" FontSize="11" Foreground="#175CD3" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="时间范围" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox Width="132"
                                      Margin="10,0,0,0"
                                      ItemsSource="{Binding DateRanges}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedDateRange, Mode=TwoWay}"
                                      IsEnabled="{Binding IsNotBusy}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVisibility}}">
                                <DatePicker Width="128"
                                            SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsNotBusy}" />
                                <TextBlock Text="至" Foreground="{StaticResource TextMutedBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <DatePicker Width="128"
                                            SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>
                            <CheckBox Content="所有分支"
                                      IsChecked="{Binding IncludeAllBranches, Mode=TwoWay}"
                                      IsEnabled="{Binding IsNotBusy}"
                                      Margin="22,0,0,0"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="取消"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Click="CancelStatistics_Click"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="开始统计"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="108"
                                    Click="StartStatistics_Click"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,12,0,0"
                            Padding="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="过滤大提交"
                                          IsChecked="{Binding LargeCommitFilterEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding IsNotBusy}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="文件数 ≥"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox Width="50"
                                         Height="28"
                                         Padding="6,1"
                                         Margin="6,0,0,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding LargeCommitFileThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditLargeCommitFilter}" />
                                <TextBlock Text="个"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="或 单次新增行数 >"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox Width="64"
                                         Height="28"
                                         Padding="6,1"
                                         Margin="6,0,0,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding LargeCommitAdditionThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanEditLargeCommitFilter}" />
                                <TextBlock Text="行"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding LargeCommitFilterDescription}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="17,14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="项目数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedProjectCount}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ProjectSelectionHint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#EFF4FF" VerticalAlignment="Top">
                            <TextBlock Text="项" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="17,14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="提交次数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalCommits, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ContributorHint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#F4F0FF" VerticalAlignment="Top">
                            <TextBlock Text="提" Foreground="#7A5AF8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="17,14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="新增行数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalAdditions, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="选中项目合计" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#ECFDF3" VerticalAlignment="Top">
                            <TextBlock Text="+" Foreground="#12B76A" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="17,14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="删除行数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDeletions, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="选中项目合计" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#FEF3F2" VerticalAlignment="Top">
                            <TextBlock Text="−" Foreground="#F04438" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="17,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="净变化" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalNet, Converter={StaticResource SignedNumber}}"
                                       Foreground="{Binding TotalNet, Converter={StaticResource NetBrush}}"
                                       FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="新增 − 删除" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#ECFDF3" VerticalAlignment="Top">
                            <TextBlock Text="∑" Foreground="#12B76A" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="统计结果" FontSize="15" FontWeight="SemiBold" />
                            <Border Background="#F2F4F7" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ResultScopeText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RangeCaption}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ResultTimestampText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="导出 CSV"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ExportCsv_Click"
                                    IsEnabled="{Binding CanExport}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FFFAEB"
                            BorderBrush="#FEDF89"
                            BorderThickness="0,1,0,1"
                            Padding="20,7"
                            Visibility="{Binding IsResultStale, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" Foreground="#B54708" FontWeight="Bold" />
                            <TextBlock Text="统计条件已变更，当前结果尚未刷新。" FontSize="11" Foreground="#B54708" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="2" Margin="20,8,20,14">
                        <TabItem Header="人员汇总">
                            <Grid Background="White">
                                <DataGrid ItemsSource="{Binding AuthorRows}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="贡献者" Width="2.3*" SortMemberPath="DisplayName">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
