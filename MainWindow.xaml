                                                                    <Border Background="#F8FAFC"
                                                                            BorderBrush="#EAECF0"
                                                                            BorderThickness="0,0,0,1"
                                                                            Padding="14,8">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                                            <Border Background="#EAF2FF" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 位}"
                                                                                           FontSize="10"
                                                                                           Foreground="#175CD3" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ItemsPresenter />
                                                                </StackPanel>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="贡献者" Width="2.1*" SortMemberPath="DisplayName">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="#EAF2FF">
                                                            <TextBlock Text="{Binding Initial}"
                                                                       Foreground="#2563EB"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
