                                                                       FontWeight="SemiBold"
                                                                       FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding DisplayName}" />
                                                            <TextBlock Text="{Binding EmailDisplay}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding EmailDisplay}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="提交次数"
                                                            Binding="{Binding Commits, StringFormat={}{0:N0}}"
                                                            Width="90"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                        <DataGridTextColumn Header="过滤提交"
                                                            Binding="{Binding FilteredCommits, StringFormat={}{0:N0}}"
                                                            Width="82"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                        <DataGridTextColumn Header="新增行数"
                                                            Binding="{Binding Additions, StringFormat={}{0:N0}}"
                                                            Width="100"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                        <DataGridTextColumn Header="删除行数"
                                                            Binding="{Binding Deletions, StringFormat={}{0:N0}}"
                                                            Width="100"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                        <DataGridTextColumn Header="净变化"
                                                            Binding="{Binding Net, Converter={StaticResource SignedNumber}}"
                                                            Width="100"
                                                            HeaderStyle="{StaticResource RightColumnHeader}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCellText}">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{Binding Net, Converter={StaticResource NetBrush}}" />
                                                </Style>
