                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="变更文件"
                                                            Binding="{Binding ChangedFiles, StringFormat={}{0:N0}}"
                                                            Width="90"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="提交详情">
                            <Grid Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="210" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource CardStyle}"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Height="34">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="贡献者"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Width="190"
                                                          Height="32"
                                                          Margin="8,0,0,0"
                                                          ItemsSource="{Binding AuthorRows}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedItem="{Binding SelectedDetailAuthor, Mode=TwoWay}" />
                                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="提交" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedDetailCommitCount, StringFormat={}{0:N0}}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Margin="4,0,12,0"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="#FFFAEB"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="命中大提交过滤的提交仍计入提交次数，但不计入新增/删除行数。"
                                                            Visibility="{Binding HasSelectedDetailFilteredCommits, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding SelectedDetailFilteredCommitCount, StringFormat='已过滤 {0:N0} 次'}"
                                                                   FontSize="10"
                                                                   Foreground="#B54708"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="新增" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedDetailAdditions, StringFormat={}{0:N0}}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               Margin="4,0,12,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="删除" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedDetailDeletions, StringFormat={}{0:N0}}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               Margin="4,0,12,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="净变化" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedDetailNet, Converter={StaticResource SignedNumber}}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding SelectedDetailNet, Converter={StaticResource NetBrush}}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="新增" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,12,0" VerticalAlignment="Center" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="删除" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,14,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CommitChartHint}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Height="108" VerticalAlignment="Top" Margin="0,0,8,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding CommitChartMaxText}"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding CommitChartMidText}"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2"
                                                           Text="0"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom" />
                                            </Grid>

                                            <Grid Grid.Column="1">
                                                <Grid Height="108" VerticalAlignment="Top">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" BorderBrush="#EAECF0" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                                                    <Border Grid.Row="1" BorderBrush="#F2F4F7" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                                                    <Border Grid.Row="2" BorderBrush="#EAECF0" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <ScrollViewer Height="148"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              PanningMode="HorizontalOnly">
                                                    <ItemsControl ItemsSource="{Binding CommitChartRows}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="42"
                                                                      Height="130"
                                                                      Background="Transparent"
                                                                      ToolTip="{Binding ToolTipText}">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="108" />
                                                                        <RowDefinition Height="22" />
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Grid.Row="0"
                                                                                Orientation="Horizontal"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Bottom">
                                                                        <Rectangle Width="10"
                                                                                   Height="{Binding AddBarHeight}"
                                                                                   Fill="{StaticResource SuccessBrush}"
                                                                                   RadiusX="2"
                                                                                   RadiusY="2"
                                                                                   VerticalAlignment="Bottom"
                                                                                   Margin="0,0,2,0" />
                                                                        <Rectangle Width="10"
                                                                                   Height="{Binding DeleteBarHeight}"
                                                                                   Fill="{StaticResource DangerBrush}"
                                                                                   RadiusX="2"
                                                                                   RadiusY="2"
                                                                                   VerticalAlignment="Bottom" />
                                                                    </StackPanel>
                                                                    <Border HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            Background="#FFFAEB"
                                                                            CornerRadius="3"
                                                                            Padding="3,0"
                                                                            Margin="0,1,0,0"
                                                                            ToolTip="{Binding FilterReason}"
                                                                            Visibility="{Binding IsLineCountFiltered, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="滤"
                                                                                   FontSize="8"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#B54708" />
                                                                    </Border>
                                                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding AxisDateText}"
                                                                                   FontSize="8.5"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{Binding AxisTimeText}"
                                                                                   FontSize="7.5"
                                                                                   Foreground="#C0C6D1"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,1,0,0" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Background="#F9FAFB"
                                                BorderBrush="#EAECF0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding HasNoSelectedCommitDetails, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="暂无提交可展示"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="选择有提交记录的贡献者后，这里会显示每次提交的新增与删除行数。"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,5,0,0"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,10,0,4">
                                    <TextBlock Text="提交明细" FontSize="12" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="按提交时间倒序 · 悬停柱形可查看完整信息"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Button Content="全屏查看"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="28"
                                                Padding="12,0"
                                                FontSize="10.5"
                                                Click="OpenCommitDetailsWindow_Click"
                                                IsEnabled="{Binding HasSelectedCommitDetails}"
                                                ToolTip="在全屏窗口中查看当前贡献者的全部提交明细（Esc 退出）" />
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding SelectedAuthorCommits}"
                                          RowHeight="44"
                                          ColumnHeaderHeight="36">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLineCountFiltered}" Value="True">
                                                    <Setter Property="Background" Value="#FFFCF5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="提交时间"
                                                            Binding="{Binding DateText}"
                                                            Width="124">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCellText}">
                                                    <Setter Property="TextAlignment" Value="Left" />
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="项目" Width="1.1*" SortMemberPath="ProjectName">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProjectName}"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ProjectPath}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="提交信息" Width="2.4*" SortMemberPath="Subject">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Subject}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ToolTipText}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <Border Background="#F2F4F7"
                                                                    CornerRadius="4"
                                                                    Padding="5,1"
                                                                    Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ShortHash}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="9.5"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Border>
                                                            <Border Background="#FFFAEB"
                                                                    CornerRadius="4"
                                                                    Padding="5,1"
                                                                    ToolTip="{Binding FilterReason}"
                                                                    Visibility="{Binding IsLineCountFiltered, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding FilterStatusText}"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#B54708" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="计入新增"
                                                            Binding="{Binding CountedAdditions, StringFormat={}{0:N0}}"
                                                            Width="86"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                        <DataGridTextColumn Header="计入删除"
                                                            Binding="{Binding CountedDeletions, StringFormat={}{0:N0}}"
                                                            Width="86"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                        <DataGridTextColumn Header="净变化"
                                                            Binding="{Binding Net, Converter={StaticResource SignedNumber}}"
                                                            Width="86"
                                                            HeaderStyle="{StaticResource RightColumnHeader}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCellText}">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{Binding Net, Converter={StaticResource NetBrush}}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="文件"
                                                            Binding="{Binding ChangedFiles, StringFormat={}{0:N0}}"
                                                            Width="66"
                                                            HeaderStyle="{StaticResource RightColumnHeader}"
                                                            ElementStyle="{StaticResource NumberCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusTone, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,12,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ModeEngineText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
