<Window x:Class="GitCount.CommitDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提交明细 - GitCount"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="FullNumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="FullRightHeader"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1220">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#2563EB">
                        <TextBlock Text="G"
                                   FontFamily="Segoe UI"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-3,0,0" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="提交明细全屏视图" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="完整查看当前贡献者的逐次提交记录" FontSize="10.5" Foreground="#8290A8" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Content="退出全屏  Esc"
                        Style="{StaticResource TextButton}"
                        Foreground="#AFC0DB"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,0">
            <StackPanel>
                <TextBlock Text="提交明细" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedDetailAuthor.DisplayName, StringFormat=当前贡献者：{0}}"
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding RangeCaption}"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12" Margin="24,12,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="贡献者"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox Width="210"
                              Height="32"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding AuthorRows}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedDetailAuthor, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="提交" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedDetailCommitCount, StringFormat={}{0:N0}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="5,0,20,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="新增" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedDetailAdditions, StringFormat={}{0:N0}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="5,0,20,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="删除" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedDetailDeletions, StringFormat={}{0:N0}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="5,0,20,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="净变化" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedDetailNet, Converter={StaticResource SignedNumber}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{Binding SelectedDetailNet, Converter={StaticResource NetBrush}}"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFAEB"
                            CornerRadius="5"
                            Padding="7,2"
                            Margin="0,0,14,0"
                            Visibility="{Binding HasSelectedDetailFilteredCommits, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedDetailFilteredCommitCount, StringFormat='已过滤 {0:N0} 次'}"
                                   FontSize="10"
                                   Foreground="#B54708" />
                    </Border>
                    <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="新增" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,14,0" VerticalAlignment="Center" />
                    <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="删除" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="1" Margin="24,12,24,20">
            <Grid>
                <DataGrid ItemsSource="{Binding SelectedAuthorCommits}"
                          RowHeight="46"
                          ColumnHeaderHeight="42"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLineCountFiltered}" Value="True">
                                    <Setter Property="Background" Value="#FFFCF5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="提交时间"
                                            Binding="{Binding DateText}"
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FullNumberCell}">
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="项目" Width="1.1*" SortMemberPath="ProjectName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProjectName}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ProjectPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="提交信息" Width="2.6*" SortMemberPath="Subject">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Subject}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ToolTipText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="#F2F4F7" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ShortHash}"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="#FFFAEB"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    ToolTip="{Binding FilterReason}"
                                                    Visibility="{Binding IsLineCountFiltered, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding FilterStatusText}"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#B54708" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="计入新增"
                                            Binding="{Binding CountedAdditions, StringFormat={}{0:N0}}"
                                            Width="110"
                                            HeaderStyle="{StaticResource FullRightHeader}"
                                            ElementStyle="{StaticResource FullNumberCell}" />
                        <DataGridTextColumn Header="计入删除"
                                            Binding="{Binding CountedDeletions, StringFormat={}{0:N0}}"
                                            Width="110"
                                            HeaderStyle="{StaticResource FullRightHeader}"
                                            ElementStyle="{StaticResource FullNumberCell}" />
                        <DataGridTextColumn Header="净变化"
                                            Binding="{Binding Net, Converter={StaticResource SignedNumber}}"
                                            Width="110"
                                            HeaderStyle="{StaticResource FullRightHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FullNumberCell}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{Binding Net, Converter={StaticResource NetBrush}}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="文件"
                                            Binding="{Binding ChangedFiles, StringFormat={}{0:N0}}"
                                            Width="86"
                                            HeaderStyle="{StaticResource FullRightHeader}"
                                            ElementStyle="{StaticResource FullNumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="White"
                        Visibility="{Binding HasNoSelectedCommitDetails, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="暂无提交明细" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="请返回主窗口完成统计并选择有提交记录的贡献者。"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
